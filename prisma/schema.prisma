generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id              String             @id @default(cuid())
  domain          String             @unique
  name            String
  slug            String             @unique
  country         String?
  industry        String?
  platform        String?
  featured        Boolean            @default(false)
  optedOut        Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  scans           Scan[]
  subscription    Subscription?
  auditOrders     AuditOrder[]
  alerts          Alert[]
  products        Product[]
  imports         ProductImport[]
  prompts         VisibilityPrompt[]
  visibilityRuns  VisibilityRun[]
  members         BrandMember[]
  storeLinks      StoreLink[]
  domainClaims    DomainClaim[]
  importJobs      ImportJob[]
  credits         CreditEntry[]
  competitors     Competitor[]
  competitorSlots CompetitorSlot[]

  @@index([country])
  @@index([industry])
}

enum ScanMode {
  SHALLOW
  DEEP
}

enum ScanStatus {
  QUEUED
  RUNNING
  COMPLETE
  FAILED
}

model Scan {
  id            String         @id @default(cuid())
  brand         Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId       String
  mode          ScanMode       @default(SHALLOW)
  status        ScanStatus     @default(QUEUED)
  score         Int?
  grade         String?
  dimensions    Json?
  urlsFetched   Int            @default(0)
  durationMs    Int?
  error         String?
  rubricVersion String         @default("1.0.0")
  isPublic      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  finishedAt    DateTime?
  signals       SignalResult[]

  @@index([brandId, createdAt])
  @@index([score])
}

model SignalResult {
  id        String @id @default(cuid())
  scan      Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId    String
  signalId  String
  dimension String
  points    Float
  maxPoints Float
  status    String
  detail    String
  evidence  Json?

  @@unique([scanId, signalId])
  @@index([scanId])
}

enum PlanTier {
  MONITOR
  AGENCY
}

model Subscription {
  id                   String   @id @default(cuid())
  brand                Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId              String   @unique
  email                String
  tier                 PlanTier @default(MONITOR)
  stripeCustomerId     String?
  stripeSubscriptionId String?  @unique
  stripeSessionId      String?  @unique
  status               String   @default("incomplete")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model AuditOrder {
  id                    String    @id @default(cuid())
  brand                 Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId               String
  email                 String?
  amountCents           Int
  currency              String    @default("chf")
  stripeSessionId       String    @unique
  stripePaymentIntentId String?
  status                String    @default("pending")
  deepScanId            String?
  createdAt             DateTime  @default(now())
  paidAt                DateTime?

  @@index([brandId])
}

/// A product imported from a shop feed. Only public catalogue data is stored.
model Product {
  id          String             @id @default(cuid())
  brand       Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId     String
  externalId  String
  title       String
  description String?
  category    String?
  vendor      String?
  priceCents  Int?
  currency    String?
  gtin        String?
  url         String?
  imageUrl    String?
  source      String
  /// Only tracked products consume credits in a visibility run.
  tracked     Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  prompts     VisibilityPrompt[]

  @@unique([brandId, externalId])
  @@index([brandId])
  @@index([brandId, tracked])
}

model ProductImport {
  id           String    @id @default(cuid())
  brand        Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId      String
  source       String
  sourceUrl    String?
  status       String    @default("running")
  productCount Int       @default(0)
  error        String?
  createdAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([brandId, createdAt])
}

/// A search phrase we ask the models, derived from the imported catalogue.
model VisibilityPrompt {
  id        String             @id @default(cuid())
  brand     Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId   String
  product   Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId String?
  text      String
  intent    String
  locale    String             @default("de-CH")
  active    Boolean            @default(true)
  /// Drives run rotation, so successive runs cover the whole catalogue.
  lastRunAt DateTime?
  createdAt DateTime           @default(now())
  results   VisibilityResult[]

  @@unique([brandId, locale, text])
  @@index([brandId, active, lastRunAt])
}

model VisibilityRun {
  id              String             @id @default(cuid())
  brand           Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId         String
  status          String             @default("running")
  trigger         String             @default("manual")
  providers       String[]
  promptsRun      Int                @default(0)
  score           Int?
  mentionRate     Float?
  citationRate    Float?
  avgRank         Float?
  shareOfVoice    Json?
  recommendations Json?
  locales         String[]
  productsCovered Int                @default(0)
  creditsUsed     Int                @default(0)
  costCents       Int                @default(0)
  error           String?
  createdAt       DateTime           @default(now())
  finishedAt      DateTime?
  results         VisibilityResult[]

  @@index([brandId, createdAt])
}

model VisibilityResult {
  id          String           @id @default(cuid())
  run         VisibilityRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId       String
  prompt      VisibilityPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  promptId    String
  provider    String
  model       String
  mentioned   Boolean          @default(false)
  cited       Boolean          @default(false)
  rank        Int?
  competitors String[]
  citations   String[]
  answer      String
  error       String?
  createdAt   DateTime         @default(now())

  @@index([runId])
  @@index([promptId, createdAt])
}

/// A merchant account. Passwordless: identity is proven by an emailed link.
model User {
  id          String        @id @default(cuid())
  email       String        @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  memberships BrandMember[]
  sessions    AuthSession[]
  storeLinks  StoreLink[]
  claims      DomainClaim[]
}

/// Which shops an account may see and re-scan.
model BrandMember {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId   String
  role      String   @default("owner")
  createdAt DateTime @default(now())

  @@unique([userId, brandId])
  @@index([brandId])
}

/// Only the hash of a session token is stored, so a database leak is not a login.
model AuthSession {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Single-use magic-link token, hashed and short-lived.
model LoginToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

/// A retailer the models named in an answer. Aggregated per customer shop, so
/// the dashboard can show who wins each phrase — and so shops that beat a
/// customer without being customers themselves become an outreach list.
model Competitor {
  id          String   @id @default(cuid())
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId     String
  name        String
  domain      String?
  /// Added by the shop to be watched every run, rather than discovered in an answer.
  tracked     Boolean  @default(false)
  /// Answers this retailer was named in.
  mentions    Int      @default(0)
  /// Answers where it was named and the customer was not.
  wins        Int      @default(0)
  bestRank    Int?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([brandId, name])
  @@index([brandId, mentions])
}

/// One paid competitor-monitoring slot. Slots are counted, not stored on the brand,
/// so a retried webhook cannot grant the same subscription twice.
model CompetitorSlot {
  id                   String   @id @default(cuid())
  brand                Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId              String
  stripeSubscriptionId String?  @unique
  stripeSessionId      String?  @unique
  status               String   @default("active")
  createdAt            DateTime @default(now())

  @@index([brandId, status])
}

/// A provider answer reused across shops within its TTL: identical phrases in the
/// same model and locale are billed to tokens once, not once per customer.
model AnswerCache {
  id        String   @id @default(cuid())
  key       String   @unique
  provider  String
  model     String
  locale    String
  prompt    String
  answer    String
  citations String[]
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Prepaid visibility credits. One credit buys one tracked product asked to one
/// model in one locale; the ledger is append-only so margin stays auditable.
model CreditEntry {
  id        String   @id @default(cuid())
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId   String
  delta     Int
  reason    String
  runId     String?
  createdAt DateTime @default(now())

  @@index([brandId, createdAt])
}

model Alert {
  id        String    @id @default(cuid())
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId   String
  kind      String
  fromScore Int?
  toScore   Int?
  message   String
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([brandId, createdAt])
}

/// A store an account keeps: its own (proved by an email at the domain) or a
/// competitor's, which needs no proof because everything measured is public.
model StoreLink {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  brand      Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId    String
  kind       String    @default("watched")
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, brandId])
  @@index([brandId])
}

/// Ownership proof: a code mailed to a role address at the domain. Only the hash
/// is stored, so the mailbox is the only place the code exists.
model DomainClaim {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId   String
  email     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, brandId, createdAt])
}

/// Catalogue scraping is a resumable job, not a request: a large catalogue
/// survives a timeout and the dashboard can show where it got to.
model ImportJob {
  id            String    @id @default(cuid())
  brand         Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId       String
  kind          String    @default("watched")
  state         String    @default("queued")
  source        String?
  sourceUrl     String?
  maxProducts   Int
  itemsFound    Int       @default(0)
  itemsImported Int       @default(0)
  attempts      Int       @default(0)
  error         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  startedAt     DateTime?
  finishedAt    DateTime?

  @@index([state, createdAt])
  @@index([brandId, createdAt])
}
