generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id          String   @id @default(cuid())
  domain      String   @unique
  name        String
  slug        String   @unique
  country     String?
  industry    String?
  platform    String?
  featured    Boolean  @default(false)
  optedOut    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  scans       Scan[]
  subscription Subscription?
  auditOrders AuditOrder[]
  alerts      Alert[]

  @@index([country])
  @@index([industry])
}

enum ScanMode {
  SHALLOW
  DEEP
}

enum ScanStatus {
  QUEUED
  RUNNING
  COMPLETE
  FAILED
}

model Scan {
  id            String       @id @default(cuid())
  brand         Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId       String
  mode          ScanMode     @default(SHALLOW)
  status        ScanStatus   @default(QUEUED)
  score         Int?
  grade         String?
  dimensions    Json?
  urlsFetched   Int          @default(0)
  durationMs    Int?
  error         String?
  rubricVersion String       @default("1.0.0")
  isPublic      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  finishedAt    DateTime?
  signals       SignalResult[]

  @@index([brandId, createdAt])
  @@index([score])
}

model SignalResult {
  id        String  @id @default(cuid())
  scan      Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId    String
  signalId  String
  dimension String
  points    Float
  maxPoints Float
  status    String
  detail    String
  evidence  Json?

  @@index([scanId])
  @@unique([scanId, signalId])
}

enum PlanTier {
  MONITOR
  AGENCY
}

model Subscription {
  id                   String   @id @default(cuid())
  brand                Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId              String   @unique
  email                String
  tier                 PlanTier @default(MONITOR)
  stripeCustomerId     String?
  stripeSubscriptionId String?  @unique
  status               String   @default("incomplete")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model AuditOrder {
  id                    String    @id @default(cuid())
  brand                 Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId               String
  email                 String?
  amountCents           Int
  currency              String    @default("chf")
  stripeSessionId       String    @unique
  stripePaymentIntentId String?
  status                String    @default("pending")
  deepScanId            String?
  createdAt             DateTime  @default(now())
  paidAt                DateTime?

  @@index([brandId])
}

model Alert {
  id        String   @id @default(cuid())
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId   String
  kind      String
  fromScore Int?
  toScore   Int?
  message   String
  sentAt    DateTime?
  createdAt DateTime @default(now())

  @@index([brandId, createdAt])
}
