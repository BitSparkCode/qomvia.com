# Postgres. Any provider works; the schema is plain Prisma/Postgres.
DATABASE_URL="postgresql://user:password@localhost:5432/agent_commerce?schema=public"

# Public base URL, no trailing slash. Falls back to https://agent-commerce.io.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stripe. Without these, checkout returns a 503 and the rest of the site works.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# IndexNow key (any 8-128 char hex string you choose). Also served at /<key>.txt.
INDEXNOW_KEY=""

# Shared secret for POST /api/cron/rescan (Bearer token).
CRON_SECRET=""
